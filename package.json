{
  "name": "@sairamanapb/icons",
  "version": "1.1.0",
  "description": "1,034 theme-aware, tree-shakeable stroke icons in 26 categories for React/TypeScript, vanilla JS, HTML, Go and Rust. currentColor-only, zero-dependency JS, semantic CSS animations, swaps, shapes, fill/duotone, glass/gradient effects, CSS-3D, 12 duotone illustrations and a Rust GPUI adapter.",
  "keywords": [
    "icons",
    "svg",
    "react",
    "typescript",
    "javascript",
    "currentColor",
    "tailwind",
    "nextjs",
    "design-system",
    "icon-set",
    "animation",
    "accessibility",
    "go",
    "rust",
    "gpui",
    "nexa-icons"
  ],
  "license": "ISC",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "js",
    "sprite.svg",
    "README.md",
    "LICENSE",
    "NOTICE",
    "data/swaps.json",
    "nexa-icon-styles-SKILL.md",
    "AGENTS.md",
    "data/categories.json",
    "illustrations/preview.html",
    "illustrations/*.svg",
    "illustrations/manifest.json",
    "illustrations/README.md",
    "llms.txt",
    "llm.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    },
    "./animations.css": "./dist/animations.css",
    "./js": {
      "types": "./js/index.d.ts",
      "import": "./js/index.mjs",
      "require": "./js/index.cjs"
    },
    "./sprite.svg": "./sprite.svg",
    "./package.json": "./package.json",
    "./react/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./data/swaps.json": "./data/swaps.json",
    "./*": {
      "types": "./dist/categories/*.d.ts",
      "import": "./dist/categories/*.js",
      "require": "./dist/cjs/categories/*.js"
    },
    "./illustrations/*": "./illustrations/*",
    "./data/categories.json": "./data/categories.json",
    "./effects.css": "./dist/effects.css",
    "./lucide": {
      "types": "./dist/lucide.d.ts",
      "import": "./dist/lucide.js",
      "require": "./dist/cjs/lucide.js",
      "default": "./dist/lucide.js"
    }
  },
  "scripts": {
    "generate:data": "node scripts/generate-data.mjs",
    "generate:react": "node scripts/generate-react.mjs",
    "generate:js": "node scripts/generate-js.mjs",
    "generate:go": "node scripts/generate-go.mjs",
    "generate:rust": "node scripts/generate-rust.mjs",
    "generate": "node scripts/generate-all.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gallery": "node gallery/build.mjs",
    "bench": "node bench/bench.mjs",
    "test": "node --test tests/",
    "test:go": "cd go && go vet ./... && go test ./...",
    "test:rust": "cd rust && cargo test",
    "pm-check": "bash scripts/package-managers.sh",
    "verify": "node scripts/verify.mjs",
    "release": "node scripts/generate-all.mjs && npm test && node scripts/verify.mjs",
    "bench:compare": "node bench/compare-lucide.mjs",
    "prepublishOnly": "npm run release && node gallery/build.mjs && npm pack --dry-run",
    "design:build": "node design/nexa-2.0/build.mjs",
    "design:qa": "node design/nexa-2.0/qa.mjs",
    "design:sheets": "node design/nexa-2.0/full-sheet.mjs",
    "design:all": "node design/nexa-2.0/build.mjs && node design/nexa-2.0/qa.mjs && node design/nexa-2.0/full-sheet.mjs",
    "design:snapshots": "python3 design/nexa-2.0/snapshots.py"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramanasai/nexa-icons.git"
  },
  "homepage": "https://ramanasai.github.io/nexa-icons/",
  "bugs": {
    "url": "https://github.com/ramanasai/nexa-icons/issues"
  },
  "author": {
    "name": "Nexa Icons contributors"
  },
  "publishConfig": {
    "access": "public"
  }
}
